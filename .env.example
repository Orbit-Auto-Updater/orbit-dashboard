# Copy to .env and fill in. Never commit .env.

# PostgreSQL password (letters and digits only, it's embedded in a URL).
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Public hostname for HTTPS (docker compose --profile https), e.g. dash.example.com
DOMAIN=
# Email for Let's Encrypt expiry notices (optional)
ACME_EMAIL=

# Where the dashboard port is published. Keep 127.0.0.1 when using Caddy or
# another reverse proxy on this host.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=3000

# Version string baked into the agent binaries served at /downloads
AGENT_VERSION=0.1.0

# Alternatively keep the database URL out of the environment with a Docker
# secret and DATABASE_URL_FILE (see DEPLOY.md).

# Timezone for log timestamps
TZ=UTC
